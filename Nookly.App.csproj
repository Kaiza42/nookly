<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <DefaultItemExcludes>$(DefaultItemExcludes);Nookly.Api\**;Nookly.Application\**;Nookly.Domain\**;Nookly.Infrastructure\**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
