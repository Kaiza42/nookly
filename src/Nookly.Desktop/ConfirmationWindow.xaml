<Window x:Class="Nookly.Desktop.ConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="430" Height="230" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#26302C" />
            <Setter Property="BorderBrush" Value="#C9D1CD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EEF1EF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerDialogButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="#8E3F3A" />
            <Setter Property="BorderBrush" Value="#8E3F3A" />
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#773530" />
                    <Setter Property="BorderBrush" Value="#773530" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border Background="#F8F9FA" BorderBrush="#D5DDD9" BorderThickness="1" CornerRadius="8">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Supprimer de la bibliotheque" FontSize="19" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="&#xE711;" Click="Cancel_Click"
                        Width="30" Height="30" Background="Transparent" BorderThickness="0"
                        FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#68727D"
                        Cursor="Hand" FocusVisualStyle="{x:Null}" />
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,18,0,18" VerticalAlignment="Center">
                <TextBlock x:Name="ConfirmationText" Foreground="#4D5967" FontSize="14"
                           TextWrapping="Wrap" />
                <TextBlock Text="Le titre sera retire de ta liste personnelle."
                           Margin="0,7,0,0" Foreground="#7A838D" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" Click="Cancel_Click" Style="{StaticResource DialogButton}"
                        Margin="0,0,9,0" IsCancel="True" />
                <Button Content="Supprimer" Click="Confirm_Click"
                        Style="{StaticResource DangerDialogButton}" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
