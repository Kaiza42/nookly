<Window x:Class="Nookly.Desktop.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="470" Height="460" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="PickerButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.86" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource ThemeBackgroundBrush}"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="9">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="225" />
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Choisir une couleur" FontSize="19" FontWeight="SemiBold" />
                <Button Grid.Column="1" Content="&#xE711;" Click="Cancel_Click"
                        Background="Transparent" BorderThickness="0" FontFamily="Segoe MDL2 Assets"
                        FontSize="12" Foreground="{DynamicResource ThemeMutedTextBrush}" Cursor="Hand" FocusVisualStyle="{x:Null}" />
            </Grid>
            <Border x:Name="ColorArea" Grid.Row="1" Margin="0,16,0,0" CornerRadius="6"
                    MouseLeftButtonDown="ColorArea_MouseLeftButtonDown"
                    MouseMove="ColorArea_MouseMove" MouseLeftButtonUp="ColorArea_MouseLeftButtonUp">
                <Grid ClipToBounds="True">
                    <Border x:Name="HueSurface" Background="#FF0000" />
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="White" Offset="0" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="Black" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Ellipse x:Name="SelectionMarker" Width="14" Height="14"
                             Stroke="White" StrokeThickness="2" IsHitTestVisible="False">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="0" Opacity="0.8" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Grid>
            </Border>
            <Slider x:Name="HueSlider" Grid.Row="2" Minimum="0" Maximum="360" Margin="0,13,0,0"
                    ValueChanged="HueSlider_ValueChanged">
                <Slider.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#FF0000" Offset="0" />
                        <GradientStop Color="#FFFF00" Offset="0.167" />
                        <GradientStop Color="#00FF00" Offset="0.333" />
                        <GradientStop Color="#00FFFF" Offset="0.5" />
                        <GradientStop Color="#0000FF" Offset="0.667" />
                        <GradientStop Color="#FF00FF" Offset="0.833" />
                        <GradientStop Color="#FF0000" Offset="1" />
                    </LinearGradientBrush>
                </Slider.Background>
            </Slider>
            <Grid Grid.Row="3" Margin="0,18,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="ColorPreview" Width="36" Height="36" CornerRadius="6"
                        BorderBrush="#BFC7C3" BorderThickness="1" />
                <TextBox x:Name="HexText" Grid.Column="1" Margin="10,0,0,0" Height="36"
                         Padding="10,0" VerticalContentAlignment="Center" IsReadOnly="True"
                        Background="{DynamicResource ThemeSurfaceBrush}"
                        Foreground="{DynamicResource ThemeTextBrush}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" />
            </Grid>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" Click="Cancel_Click" IsCancel="True"
                        Style="{StaticResource PickerButton}" Margin="0,0,9,0" />
                <Button Content="Choisir" Click="Confirm_Click" IsDefault="True"
                        Style="{StaticResource PickerButton}" Background="{DynamicResource ThemeAccentBrush}"
                        BorderBrush="{DynamicResource ThemeAccentBrush}" Foreground="White" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
