<Window x:Class="Nookly.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Nookly.Desktop.Converters"
        Title="Nookly"
        Height="680"
        Width="1080"
        MinHeight="560"
        MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded"
        Background="#F5F6F8">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="12,2" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#B8C0CC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#20242B">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="78" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="60" />
                </Grid.RowDefinitions>

                <TextBlock Text="Nookly"
                           Margin="26,0"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="SemiBold" />

                <StackPanel Grid.Row="1">
                    <Button Content="Accueil" Style="{StaticResource NavButtonStyle}" />
                    <Button Content="Bibliotheque"
                            Style="{StaticResource NavButtonStyle}"
                            Background="#343A44"
                            Foreground="White"
                            FontWeight="SemiBold" />
                    <Button Content="Notes" Style="{StaticResource NavButtonStyle}" />
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Text="Espace personnel"
                           Margin="26,0"
                           VerticalAlignment="Center"
                           Foreground="#7F8997"
                           FontSize="12" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="34,28,34,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Bibliotheque"
                               Foreground="#20242B"
                               FontSize="28"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Tes films, series, animes et mangas"
                               Margin="0,5,0,0"
                               Foreground="#69717D"
                               FontSize="14" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Actualiser"
                        Command="{Binding LoadCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                        MinWidth="110"
                        Height="38"
                        Padding="16,0"
                        Background="#FFFFFF"
                        Foreground="#20242B"
                        BorderBrush="#D7DBE1"
                        Cursor="Hand" />
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,22,0,0"
                    Padding="14,11"
                    Background="#FFF1F0"
                    BorderBrush="#E6A39E"
                    BorderThickness="1"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#8E2F2A"
                           TextWrapping="Wrap" />
            </Border>

            <Grid Grid.Row="2" Margin="0,22,0,0">
                <ProgressBar Height="3"
                             VerticalAlignment="Top"
                             IsIndeterminate="True"
                             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Ta bibliotheque est vide"
                               HorizontalAlignment="Center"
                               Foreground="#343A44"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Les medias ajoutes apparaitront ici."
                               Margin="0,7,0,0"
                               Foreground="#7A838F"
                               FontSize="14" />
                </StackPanel>

                <ListView ItemsSource="{Binding Items}"
                          Visibility="{Binding HasItems, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Background="Transparent"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="18,14"
                                    Background="White"
                                    BorderBrush="#E0E3E8"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="#20242B"
                                                   FontSize="16"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}"
                                                   Margin="0,4,18,0"
                                                   Foreground="#747D89"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TypeLabel}"
                                               VerticalAlignment="Center"
                                               Foreground="#4D5967" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding StatusLabel}"
                                               VerticalAlignment="Center"
                                               Foreground="#286C53"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding AddedDateLabel}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Foreground="#7A838F" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Window>
