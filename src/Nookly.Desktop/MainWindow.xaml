<Window x:Class="Nookly.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Nookly.Desktop.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Nookly" Height="720" Width="1120" MinHeight="500" MinWidth="760"
        WindowStartupLocation="CenterScreen" Loaded="OnLoaded" Closing="OnClosing"
        WindowStyle="None" ResizeMode="CanResize" StateChanged="Window_StateChanged"
        SizeChanged="MainWindow_SizeChanged"
        BorderThickness="0" SnapsToDevicePixels="True"
        Background="{DynamicResource ThemeBackgroundBrush}"
        Foreground="{DynamicResource ThemeTextBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="9"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBooleanConverter x:Key="InverseBoolean" />
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#B8C0CC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavSurface" Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <Grid>
                                <Border x:Name="ActiveMarker" Width="3" Height="20"
                                        Margin="2,0,0,0" HorizontalAlignment="Left"
                                        VerticalAlignment="Center" Background="Transparent"
                                        CornerRadius="2" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource ThemeSidebarHoverBrush}" />
                                <Setter Property="Foreground" Value="#EDF2F0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavSurface" Property="Background" Value="#303840" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="NavSurface" Property="Background" Value="#2A3037" />
                                <Setter TargetName="ActiveMarker" Property="Background" Value="#5E9B82" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarToggleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccountButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E6ECE9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThemeSidebarHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#3A4640" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PowerButton" TargetType="Button" BasedOn="{StaticResource AccountButton}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#AEB7C2" />
        </Style>
        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Width="10" Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb MinHeight="34">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border x:Name="ThumbSurface" Width="6" Margin="2,1"
                                            Background="#AEB7B3" CornerRadius="3" />
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ThumbSurface" Property="Background" Value="#7F8C86" />
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="ThumbSurface" Property="Background" Value="#66756E" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
        </Style>
        <Style x:Key="CleanExpander" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="HeaderToggle" Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontSize="{TemplateBinding FontSize}"
                                          FontWeight="{TemplateBinding FontWeight}"
                                          HorizontalContentAlignment="Stretch" Background="Transparent"
                                          BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderSurface" Background="Transparent" Padding="0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="Chevron" Text="&#xE76C;"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="8"
                                                           Foreground="{TemplateBinding Foreground}"
                                                           VerticalAlignment="Center" Margin="1,0,7,0" />
                                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderSurface" Property="Opacity" Value="0.82" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandContent" Grid.Row="1"
                                              Content="{TemplateBinding Content}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandContent" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimarySurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimarySurface" Property="Background" Value="{DynamicResource ThemeAccentHoverBrush}" />
                                <Setter TargetName="PrimarySurface" Property="BorderBrush" Value="{DynamicResource ThemeAccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SoftButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LibraryActionButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <Style x:Key="LibrarySearchBox" TargetType="TextBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="38,0,12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <Grid>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{DynamicResource ThemeMutedTextBrush}"
                                           Margin="13,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <TextBlock x:Name="Placeholder" Text="Rechercher dans ma bibliotheque"
                                           Margin="38,0,12,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ThemeMutedTextBrush}" Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value="" />
                                    <Condition Property="IsKeyboardFocused" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SeasonWatchedToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#F4F7F5" />
            <Setter Property="Foreground" Value="#46514C" />
            <Setter Property="BorderBrush" Value="#CCD8D2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                                <TextBlock x:Name="CheckMark" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleSurface" Property="BorderBrush" Value="#91B5A5" />
                                <Setter TargetName="ToggleSurface" Property="Background" Value="#EAF2EE" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleSurface" Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
                                <Setter TargetName="ToggleSurface" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RestoreButton" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Background" Value="#F1F8F5" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="BorderBrush" Value="#AFCFC1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RestoreSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RestoreSurface" Property="Background" Value="#E2F1EA" />
                                <Setter TargetName="RestoreSurface" Property="BorderBrush" Value="#78AC96" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RestoreSurface" Property="Background" Value="#D5E9DF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FilterTileButton" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Background" Value="#F5F7F6" />
            <Setter Property="Foreground" Value="#46514C" />
            <Setter Property="BorderBrush" Value="#D7E0DC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TileSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileSurface" Property="Background" Value="#E9EFEC" />
                                <Setter TargetName="TileSurface" Property="BorderBrush" Value="#AFC6BB" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="TileSurface" Property="Background" Value="#2A493D" />
                                <Setter TargetName="TileSurface" Property="BorderBrush" Value="#2A493D" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HoverCardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Panel.ZIndex" Value="10" />
                    <Setter Property="BorderBrush" Value="#C6D7CF" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#49675A" BlurRadius="18"
                                              ShadowDepth="3" Opacity="0.32" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#4A8ED8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTitleBarTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#16000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#26000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StaySignedInToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Track" Width="40" Height="22" HorizontalAlignment="Left"
                                    Background="#D7DDE1" BorderBrush="{DynamicResource ThemeBorderBrush}"
                                    BorderThickness="1" CornerRadius="11">
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Margin="2"
                                         HorizontalAlignment="Left" Fill="White">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#4A5550" BlurRadius="3" ShadowDepth="1" Opacity="0.3" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VoteIconButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HoverCardItem" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid>
                            <Border x:Name="ShadowSurface" Margin="2" Background="{DynamicResource ThemeSurfaceBrush}"
                                    CornerRadius="8" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="HoverSurface" Background="Transparent" CornerRadius="8">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ShadowSurface" Property="Opacity" Value="1" />
                                <Setter TargetName="ShadowSurface" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#60796E" BlurRadius="12"
                                                          ShadowDepth="2" Opacity="0.28" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="RichDetailsTemplate">
            <StackPanel HorizontalAlignment="Stretch">
                <TextBlock Margin="0,14,0,0" Foreground="{DynamicResource ThemeMutedTextBrush}" TextWrapping="Wrap">
                    <Run Text="{Binding ReleaseDateLabel, Mode=OneWay}" /><Run Text="  |  " />
                    <Run Text="{Binding RuntimeLabel, Mode=OneWay}" /><Run Text="  |  " />
                    <Run Text="{Binding StatusLabel, Mode=OneWay}" /><Run Text="  |  TMDB " />
                    <Run Text="{Binding RatingLabel, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding GenresLabel}" Margin="0,8,0,0" Foreground="{DynamicResource ThemeAccentBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,16,0,0" TextWrapping="Wrap">
                    <Run Text="Realisation : " FontWeight="SemiBold" />
                    <Run Text="{Binding DirectorsLabel, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                    <Run Text="Distribution : " FontWeight="SemiBold" />
                    <Run Text="{Binding CastLabel, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="Synopsis" Margin="0,24,0,0" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" Margin="0,8,0,0" Foreground="{DynamicResource ThemeTextBrush}"
                           LineHeight="21" TextWrapping="Wrap" MaxWidth="1050"
                           HorizontalAlignment="Left" />
                <Button Content="Voir la bande-annonce" Command="{Binding DataContext.OpenTrailerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,18,0,0"
                        Visibility="{Binding HasTrailer, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Margin="-286,28,0,0"
                            Visibility="{Binding HasSeasons, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Saisons et episodes" FontSize="19" FontWeight="SemiBold" />
                    <Expander Margin="0,12,0,0" Style="{StaticResource CleanExpander}"
                              Foreground="#26302C" FontWeight="SemiBold">
                        <Expander.Header>
                            <TextBlock>
                                <Run Text="Choisir une saison" />
                                <Run Text="  ·  " Foreground="#87918C" />
                                <Run Text="{Binding DataContext.SelectedSeason.Title, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                     Foreground="{DynamicResource ThemeAccentBrush}" />
                            </TextBlock>
                        </Expander.Header>
                        <Border Margin="0,7,0,0" Padding="10,10,4,4" Background="#EEF3F0"
                                BorderBrush="#D7E0DC" BorderThickness="1" CornerRadius="8">
                            <ItemsControl ItemsSource="{Binding Seasons}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Title}" Style="{StaticResource FilterTileButton}"
                                                Command="{Binding DataContext.SelectSeasonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Expander>
                    <ContentControl Content="{Binding DataContext.SelectedSeasonDetails, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Margin="0,14,0,0">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding MetaLabel}" Margin="0,5,0,0" Foreground="{DynamicResource ThemeMutedTextBrush}" />
                                    <TextBlock Text="{Binding Description}" Margin="0,8,0,14" Foreground="{DynamicResource ThemeTextBrush}"
                                               TextWrapping="Wrap" MaxWidth="1050"
                                               HorizontalAlignment="Left" />
                                    <ToggleButton Content="Saison vue" IsChecked="{Binding IsWatched, Mode=TwoWay}"
                                                  Style="{StaticResource SeasonWatchedToggle}"
                                                  HorizontalAlignment="Left" Margin="0,0,0,14" />
                                    <TextBlock Text="Ma note sur cette saison" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding PersonalNotes, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4000"
                                             Height="42" Padding="10,7" Margin="0,6,0,0"
                                             Style="{StaticResource RoundedTextBox}"
                                             Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                             MaxWidth="1000" HorizontalAlignment="Left"
                                             VerticalScrollBarVisibility="Auto" />
                                    <Button Content="Enregistrer la saison"
                                            Command="{Binding DataContext.SaveSeasonProgressCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,14" />
                                    <ItemsControl ItemsSource="{Binding Episodes}"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Stretch">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource HoverCardBorder}" MaxWidth="1500"
                                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        Padding="14" Margin="0,5,0,9"
                                                        HorizontalAlignment="Left">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="108" Height="61" Background="#E4E7EB" CornerRadius="6">
                                                            <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                                                <Run Text="{Binding NumberLabel, Mode=OneWay}" /><Run Text=" - " />
                                                                <Run Text="{Binding Title, Mode=OneWay}" />
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding MetaLabel}" Margin="0,3,0,0"
                                                                       Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="11" />
                                                            <TextBlock Text="{Binding Description}" Margin="0,5,0,0"
                                                                       Foreground="{DynamicResource ThemeTextBrush}" TextWrapping="Wrap"
                                                                       HorizontalAlignment="Stretch" />
                                                            <TextBox Text="{Binding PersonalNotes, UpdateSourceTrigger=PropertyChanged}"
                                                                     AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4000"
                                                                     Height="38" Padding="10,6" Margin="0,10,0,0"
                                                                     Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                                                     MaxWidth="1000" HorizontalAlignment="Left"
                                                                     Style="{StaticResource RoundedTextBox}"
                                                                     ToolTip="Note personnelle sur cet episode"
                                                                     LostKeyboardFocus="EpisodeNote_LostKeyboardFocus"
                                                                     VerticalScrollBarVisibility="Auto" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                    <TextBlock Text="{Binding DataContext.DetailsStatusMessage, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{DynamicResource ThemeAccentBrush}" Margin="0,8,0,0" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="MainRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource ThemeSidebarBrush}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />
        <Grid Grid.Column="1" Background="{DynamicResource ThemeTitleBarBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="&#xE921;" Click="MinimizeWindow_Click" Style="{StaticResource TitleBarButton}" ToolTip="Reduire" />
                <Button x:Name="MaxRestoreButton" Content="&#xE922;" Click="MaxRestoreWindow_Click"
                        Style="{StaticResource TitleBarButton}" ToolTip="Agrandir" />
                <Button Content="&#xE8BB;" Click="CloseWindow_Click" Style="{StaticResource TitleBarButton}" ToolTip="Fermer" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource ThemeSidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="68" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="58" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock x:Name="SidebarBrand" Text="Nookly" Margin="26,0" VerticalAlignment="Center"
                               Foreground="White" FontSize="24" FontWeight="SemiBold" />
                    <Button x:Name="SidebarToggleButton" Click="ToggleSidebar_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                            Width="26" Height="26" Foreground="#9FA8B4" Background="Transparent"
                            BorderThickness="0" FontFamily="Segoe MDL2 Assets" FontSize="11"
                            Style="{StaticResource SidebarToggleButtonStyle}"
                            ToolTip="Replier le menu" Cursor="Hand">
                        <TextBlock Text="&#xE76B;" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="SidebarToggleRotation" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Button>
                </Grid>
                <StackPanel x:Name="ExpandedNavigation" Grid.Row="1">
                    <Expander Header="Divertissement" IsExpanded="True" Margin="12,8,12,0"
                              Foreground="White" FontWeight="SemiBold"
                              Style="{StaticResource CleanExpander}">
                        <StackPanel Margin="0,6,0,0">
                            <Button Content="Bibliotheque" Command="{Binding ShowLibraryCommand}"
                                    Style="{StaticResource NavButton}" Margin="0,2" />
                            <Button Content="Decouvrir" Command="{Binding OpenDiscoverCommand}"
                                    Style="{StaticResource NavButton}" Margin="0,2" />
                        </StackPanel>
                    </Expander>
                    <Button Content="Banque" Command="{Binding ShowBankCommand}"
                            Style="{StaticResource NavButton}" />
                    <Button Content="Parametres" Command="{Binding ShowSettingsCommand}"
                            Style="{StaticResource NavButton}" />
                    <Button x:Name="AdministrationButton" Content="Administration"
                            Command="{Binding ShowAdminCommand}" Click="Administration_Click"
                            Style="{StaticResource NavButton}" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel x:Name="CollapsedNavigation" Grid.Row="1" Visibility="Collapsed" Margin="0,8,0,0">
                    <Button Content="&#xE8F1;" Command="{Binding ShowLibraryCommand}" ToolTip="Bibliotheque"
                            Style="{StaticResource NavButton}" FontFamily="Segoe MDL2 Assets" FontSize="18"
                            HorizontalContentAlignment="Center" Padding="0" />
                    <Button Content="&#xE721;" Command="{Binding OpenDiscoverCommand}" ToolTip="Decouvrir"
                            Style="{StaticResource NavButton}" FontFamily="Segoe MDL2 Assets" FontSize="18"
                            HorizontalContentAlignment="Center" Padding="0" />
                    <Button Content="&#xE8C7;" Command="{Binding ShowBankCommand}" ToolTip="Banque"
                            Style="{StaticResource NavButton}" FontFamily="Segoe MDL2 Assets" FontSize="18"
                            HorizontalContentAlignment="Center" Padding="0" />
                    <Button Content="&#xE713;" Command="{Binding ShowSettingsCommand}" ToolTip="Parametres"
                            Style="{StaticResource NavButton}" FontFamily="Segoe MDL2 Assets" FontSize="18"
                            HorizontalContentAlignment="Center" Padding="0" />
                    <Button x:Name="CollapsedAdministrationButton" Content="&#xE77B;"
                            Command="{Binding ShowAdminCommand}" Click="Administration_Click" ToolTip="Administration"
                            Style="{StaticResource NavButton}" FontFamily="Segoe MDL2 Assets" FontSize="18"
                            HorizontalContentAlignment="Center" Padding="0" Visibility="Collapsed" />
                </StackPanel>
                <Grid x:Name="ExpandedAccountArea" Grid.Row="2" Margin="12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="MemberButton" Click="CopyMemberId_Click" Margin="0,0,4,0"
                            Style="{StaticResource AccountButton}" ToolTip="Copier mon identifiant" />
                    <Button x:Name="PowerMenuButton" Grid.Column="1" Click="PowerMenu_Click"
                            Content="&#xE7E8;" Style="{StaticResource PowerButton}"
                            ToolTip="Options de fermeture" />
                </Grid>
                <Grid x:Name="CollapsedAccountArea" Grid.Row="2" Visibility="Collapsed" Margin="6,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Click="CopyMemberId_Click" Content="&#xE77B;" ToolTip="Copier mon identifiant"
                            Style="{StaticResource AccountButton}" HorizontalContentAlignment="Center"
                            Padding="0" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                    <Button Grid.Column="1" Click="PowerMenu_Click" Content="&#xE7E8;"
                            ToolTip="Options de fermeture" Style="{StaticResource PowerButton}"
                            Width="26" FontSize="14" />
                </Grid>
                <Popup x:Name="PowerMenuPopup" PlacementTarget="{Binding ElementName=PowerMenuButton}"
                       Placement="Top" VerticalOffset="-7" AllowsTransparency="True" StaysOpen="False">
                    <Border Width="190" Padding="5" Background="#292F37" BorderBrush="#3B444E"
                            BorderThickness="1" CornerRadius="7">
                        <StackPanel>
                            <Button Content="Quitter Nookly" Click="ExitApplication_Click"
                                    Style="{StaticResource AccountButton}" />
                            <Button Content="Se deconnecter" Click="LogoutOnly_Click"
                                    Style="{StaticResource AccountButton}" />
                            <Button Content="Se deconnecter et quitter" Click="LogoutAndExit_Click"
                                    Style="{StaticResource AccountButton}" Foreground="#E4B4B0" />
                        </StackPanel>
                    </Border>
                </Popup>
                <Popup x:Name="CopyIdPopup" Placement="Top" VerticalOffset="-7"
                       AllowsTransparency="True" StaysOpen="True">
                    <Border Padding="11,7" Background="#343B43" BorderBrush="#4A545E"
                            BorderThickness="1" CornerRadius="6">
                        <TextBlock Text="Identifiant copi&#xE9;" Foreground="#E6ECE9" FontSize="11" />
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="24,24" MaxWidth="1500" HorizontalAlignment="Stretch">
            <!-- Bibliotheque : la recherche filtre uniquement les medias deja ajoutes. -->
            <Grid Visibility="{Binding IsLibraryPage, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Bibliotheque" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Tes films, series et animes" Margin="0,5,0,0" Foreground="{DynamicResource ThemeMutedTextBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Ajouter" Command="{Binding OpenDiscoverCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                        <Button Content="Actualiser" Command="{Binding LoadCommand}"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolean}}"
                                Height="38" Padding="16,0" Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,20,0,0">
                    <TextBox Text="{Binding LibrarySearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource LibrarySearchBox}"
                             ToolTip="Rechercher uniquement dans ta bibliotheque" />
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                            Padding="8,3" Background="{DynamicResource ThemeBackgroundBrush}" CornerRadius="4"
                            Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding FilteredItems.Count, StringFormat={}{0} resultat(s)}"
                                   FontSize="11" Foreground="{DynamicResource ThemeMutedTextBrush}" />
                    </Border>
                </Grid>

                <Border Grid.Row="2" Margin="0,14,0,0" Padding="18" Background="{DynamicResource ThemeSurfaceBrush}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6"
                        Visibility="{Binding IsCreatePanelOpen, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.ColumnSpan="4" Text="Mes informations personnelles" Margin="0,0,0,14"
                                   FontSize="16" FontWeight="SemiBold" />
                        <StackPanel Grid.Row="1" Margin="0,0,12,0">
                            <TextBlock Text="Statut" Margin="0,0,0,6" Foreground="{DynamicResource ThemeMutedTextBrush}" />
                            <ComboBox ItemsSource="{Binding MediaStatuses}"
                                      SelectedItem="{Binding SelectedMediaStatus}" DisplayMemberPath="Label"
                                      Height="36" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Ma note /10" Margin="0,0,0,6" Foreground="{DynamicResource ThemeMutedTextBrush}" />
                            <TextBox Text="{Binding PersonalRatingText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="36" Padding="9,7" ToolTip="Nombre entre 0 et 10, par exemple 8,5" />
                            <CheckBox Content="Favori" IsChecked="{Binding IsFavorite}" Margin="0,10,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Text="Mes notes personnelles" Margin="0,0,0,6" Foreground="{DynamicResource ThemeMutedTextBrush}" />
                            <TextBox Text="{Binding NewPersonalNotes, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="64" MaxHeight="100" Padding="10,7"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Annuler" Command="{Binding CancelEditCommand}"
                                    Height="36" Padding="13,0" Margin="0,0,8,0" />
                            <Button Content="Enregistrer" Command="{Binding SaveMediaCommand}"
                                    Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,12,0"
                                    Visibility="{Binding EditingSupportsEpisodeProgress, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Width="120" Margin="0,0,12,0">
                                <TextBlock Text="Saison actuelle" Margin="0,0,0,6" Foreground="{DynamicResource ThemeMutedTextBrush}" />
                                <TextBox Text="{Binding CurrentSeasonText, UpdateSourceTrigger=PropertyChanged}"
                                         Height="34" Padding="8,6" />
                            </StackPanel>
                            <StackPanel Width="120">
                                <TextBlock Text="Episode actuel" Margin="0,0,0,6" Foreground="{DynamicResource ThemeMutedTextBrush}" />
                                <TextBox Text="{Binding CurrentEpisodeText, UpdateSourceTrigger=PropertyChanged}"
                                         Height="34" Padding="8,6" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"
                                   Text="{Binding FormErrorMessage}" Margin="0,14,0,0"
                                   Foreground="#A43630" TextWrapping="Wrap"
                                   Visibility="{Binding HasFormError, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="0,18,0,0">
                    <Border Panel.ZIndex="4" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Padding="11,7" Background="{DynamicResource ThemeAccentSurfaceBrush}"
                            BorderBrush="{DynamicResource ThemeAccentBrush}" BorderThickness="1" CornerRadius="6"
                            Visibility="{Binding HasLibraryStatus, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding LibraryStatusMessage}" Foreground="{DynamicResource ThemeAccentBrush}" />
                    </Border>
                    <StackPanel Panel.ZIndex="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar Width="180" Height="3" IsIndeterminate="True"
                                     Foreground="{DynamicResource ThemeAccentBrush}" />
                        <TextBlock Text="Mise a jour de ta bibliotheque..." Margin="0,12,0,0"
                                   Foreground="{DynamicResource ThemeMutedTextBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <Border Panel.ZIndex="3" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                            Padding="18,15" Background="{DynamicResource ThemeSurfaceBrush}"
                            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="7"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Impossible de charger la bibliotheque" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="{Binding ErrorMessage}" Margin="0,7,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ThemeMutedTextBrush}" />
                            <Button Content="Reessayer" Command="{Binding LoadCommand}" Margin="0,13,0,0"
                                    HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                    </Border>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Ta bibliotheque est vide" FontSize="18" FontWeight="SemiBold" />
                        <Button Content="Trouver un premier media" Command="{Binding OpenDiscoverCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" />
                    </StackPanel>
                    <TextBlock Text="Aucun resultat dans ta bibliotheque."
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ThemeMutedTextBrush}"
                               Visibility="{Binding ShowNoLibraryResults, Converter={StaticResource BoolToVisibility}}" />
                    <ListView ItemsSource="{Binding FilteredItems}"
                              Visibility="{Binding HasFilteredItems, Converter={StaticResource BoolToVisibility}}"
                              Background="Transparent" BorderThickness="0"
                              HorizontalAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource HoverCardItem}">
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <EventSetter Event="MouseDoubleClick" Handler="LibraryItem_DoubleClick" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border MinHeight="108" Padding="14,11" Background="{DynamicResource ThemeSurfaceBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="56" Height="82" VerticalAlignment="Center"
                                                Background="#E4E7EB" CornerRadius="3">
                                            <Image Source="{Binding PosterUrl}" Stretch="UniformToFill" />
                                        </Border>
                                        <Grid Grid.Column="1" Margin="12,0,16,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="1" Text="{Binding Description}" Margin="0,5,0,0"
                                                       Foreground="{DynamicResource ThemeMutedTextBrush}" TextWrapping="Wrap"
                                                       MaxHeight="38" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,7,0,0">
                                                <TextBlock Text="{Binding TypeLabel}" Foreground="{DynamicResource ThemeTextBrush}" />
                                                <TextBlock Text="  |  " Foreground="#A0A6AE" />
                                                <TextBlock Text="{Binding StatusLabel}" Foreground="{DynamicResource ThemeAccentBrush}" />
                                                <TextBlock Text="  |  " Foreground="#A0A6AE" />
                                                <TextBlock Text="{Binding RatingLabel}" Foreground="{DynamicResource ThemeTextBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="3" Text="{Binding PersonalNotes}" Margin="0,5,0,0"
                                                       Foreground="{DynamicResource ThemeAccentBrush}" FontStyle="Italic"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="&#xE890;"
                                                    Command="{Binding DataContext.ShowLibraryItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource LibraryActionButton}"
                                                    ToolTip="Voir la fiche" Margin="0,0,8,0" />
                                            <Button Content="&#xE70F;"
                                                    Command="{Binding DataContext.EditMediaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource LibraryActionButton}"
                                                    ToolTip="Modifier mes informations" Margin="0,0,7,0" />
                                            <Button Content="&#xE74D;" ToolTip="Supprimer de ma bibliotheque"
                                                    Command="{Binding DataContext.DeleteMediaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource LibraryActionButton}"
                                                    Foreground="#C43D3D" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>

            <!-- Catalogue externe : aucun resultat n'est ajoute directement. -->
            <Grid Visibility="{Binding IsDiscoverPage, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Decouvrir" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Explore les films, series et animes" Margin="0,5,0,0" Foreground="{DynamicResource ThemeMutedTextBrush}" />
                    </StackPanel>
                    <Button Content="⚄" Command="{Binding RefreshRecommendationsCommand}"
                            ToolTip="Nouvelle selection"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="28" Height="28" Padding="0" FontSize="16" FontFamily="Segoe UI Symbol"
                            Visibility="{Binding IsDiscoveryBrowseSelected, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource SoftButton}" />
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="Decouvrir" Command="{Binding ShowDiscoveryBrowseCommand}"
                            Height="30" Padding="13,0" Margin="0,0,7,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SoftButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDiscoveryBrowseSelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ThemeAccentSurfaceBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Historique" Command="{Binding ShowDiscoveryHistoryCommand}"
                            Height="30" Padding="13,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SoftButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDiscoveryHistorySelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ThemeAccentSurfaceBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                <Grid Grid.Row="2" Margin="0,12,0,0"
                      Visibility="{Binding IsDiscoveryBrowseSelected, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="DiscoveryTitleInput"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Height="34" Padding="12,6" Style="{StaticResource RoundedTextBox}"
                                 ToolTip="Rechercher sur TMDB" TextChanged="DiscoveryTitleInput_Changed"
                                 GotKeyboardFocus="DiscoveryTitleInput_Changed"
                                 LostKeyboardFocus="DiscoveryTitleInput_Changed" />
                        <TextBlock x:Name="DiscoveryTitlePlaceholder" Margin="13,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ThemeMutedTextBrush}" IsHitTestVisible="False" />
                    </Grid>
                    <Button Grid.Column="1" Content="Rechercher" Command="{Binding SearchCommand}"
                            Style="{StaticResource PrimaryButton}" Height="34" Margin="10,0,0,0" />
                </Grid>
                <Expander Grid.Row="3" Header="Filtres" IsExpanded="False" Margin="0,8,0,0"
                          Foreground="{DynamicResource ThemeTextBrush}" FontWeight="SemiBold"
                          Visibility="{Binding IsDiscoveryBrowseSelected, Converter={StaticResource BoolToVisibility}}"
                          Style="{StaticResource CleanExpander}">
                    <Border Margin="0,6,0,0" Padding="12,10" Background="{DynamicResource ThemeSurfaceBrush}"
                            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Types" Foreground="{DynamicResource ThemeMutedTextBrush}" FontWeight="SemiBold" Margin="0,6,8,0" />
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding DiscoveryMediaTypes}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Content="{Binding Label}" Command="{Binding DataContext.ToggleDiscoveryTypeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" Style="{StaticResource FilterTileButton}" />
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Grid.Row="1" Text="Genres" Foreground="{DynamicResource ThemeMutedTextBrush}" FontWeight="SemiBold" Margin="0,6,8,0" />
                        <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding DiscoveryGenres}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Content="{Binding Label}" Command="{Binding DataContext.ToggleDiscoveryGenreCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" Style="{StaticResource FilterTileButton}" />
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Grid.Row="2" Text="Pays" Foreground="{DynamicResource ThemeMutedTextBrush}" FontWeight="SemiBold" Margin="0,6,8,0" />
                        <ItemsControl Grid.Row="2" Grid.Column="1" ItemsSource="{Binding DiscoveryCountries}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Content="{Binding Label}" Command="{Binding DataContext.ToggleDiscoveryCountryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" Style="{StaticResource FilterTileButton}" />
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="Annee" Margin="0,0,7,0" Foreground="{DynamicResource ThemeMutedTextBrush}" VerticalAlignment="Center" />
                            <TextBox Text="{Binding DiscoveryYear, UpdateSourceTrigger=PropertyChanged}"
                                     Width="72" Height="28" Padding="7,1" TextAlignment="Center"
                                     VerticalContentAlignment="Center" ToolTip="Par exemple 2024"
                                     Style="{StaticResource RoundedTextBox}" />
                            <TextBlock Text="Acteur" Margin="16,0,7,0" Foreground="{DynamicResource ThemeMutedTextBrush}" VerticalAlignment="Center" />
                            <TextBox Text="{Binding ActorQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Width="170" Height="28" Padding="7,1" TextAlignment="Center"
                                     VerticalContentAlignment="Center" Style="{StaticResource RoundedTextBox}" />
                            <TextBlock Text="Realisateur" Margin="16,0,7,0" Foreground="{DynamicResource ThemeMutedTextBrush}" VerticalAlignment="Center" />
                            <TextBox Text="{Binding DirectorQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Width="170" Height="28" Padding="7,1" TextAlignment="Center"
                                     VerticalContentAlignment="Center" Style="{StaticResource RoundedTextBox}" />
                        </StackPanel>
                    </Grid>
                    </Border>
                </Expander>
                <StackPanel Grid.Row="4"
                            Visibility="{Binding IsDiscoveryBrowseSelected, Converter={StaticResource BoolToVisibility}}">
                    <ProgressBar Height="3" Margin="0,12,0,0" IsIndeterminate="True"
                                 Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding SearchErrorMessage}" Margin="0,12,0,0" Foreground="{DynamicResource ThemeDangerBrush}"
                               Visibility="{Binding HasSearchError, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <ListView Grid.Row="5" ItemsSource="{Binding SearchResults}" Margin="0,18,0,0"
                          Visibility="{Binding IsDiscoveryBrowseSelected, Converter={StaticResource BoolToVisibility}}"
                          Background="Transparent" BorderThickness="0"
                          HorizontalAlignment="Stretch"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource HoverCardItem}">
                            <Setter Property="Margin" Value="0,0,0,10" />
                            <EventSetter Event="MouseDoubleClick" Handler="DiscoveryResult_DoubleClick" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12" Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}"
                                    BorderThickness="1" CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Height="88" Background="#E4E7EB" CornerRadius="3">
                                            <Image Source="{Binding PosterUrl}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,2,20,0">
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource ThemeMutedTextBrush}">
                                                <Run Text="{Binding TypeLabel, Mode=OneWay}" /><Run Text=" - " />
                                                <Run Text="{Binding YearLabel, Mode=OneWay}" /><Run Text=" - " />
                                                <Run Text="{Binding RatingLabel, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding CastLabel}" Margin="0,5,0,0"
                                                       Foreground="{DynamicResource ThemeTextBrush}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Description}" Margin="0,7,0,0"
                                                       Foreground="{DynamicResource ThemeMutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Button Content="Voir" ToolTip="Voir la fiche"
                                                    Command="{Binding DataContext.ShowSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource SoftButton}" Margin="0,0,8,0" />
                                            <Button Content="Ajouter" ToolTip="Ajouter a ma bibliotheque"
                                                    Command="{Binding DataContext.AddSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource SoftButton}" Margin="0,0,8,0" />
                                            <Button Content="&#xE8E1;" ToolTip="J'aime"
                                                    Command="{Binding DataContext.LikeDiscoveryResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource VoteIconButton}"
                                                    Foreground="#27864A" Margin="0,0,5,0" />
                                            <Button Content="&#xE8E0;" ToolTip="Ne plus me proposer ce titre"
                                                    Command="{Binding DataContext.DislikeDiscoveryResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource VoteIconButton}"
                                                    Foreground="#C43D3D" />
                                        </StackPanel>
                                    </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Grid.Row="5" Text="Aucun contenu consulte pour le moment."
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ThemeMutedTextBrush}"
                           Visibility="{Binding ShowEmptyDiscoveryHistory, Converter={StaticResource BoolToVisibility}}" />
                <ListView Grid.Row="5" ItemsSource="{Binding DiscoveryHistory}" Margin="0,18,0,0"
                          Visibility="{Binding IsDiscoveryHistorySelected, Converter={StaticResource BoolToVisibility}}"
                          Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource HoverCardItem}">
                            <Setter Property="Margin" Value="0,0,0,10" />
                            <EventSetter Event="MouseDoubleClick" Handler="DiscoveryHistoryItem_DoubleClick" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12" Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}"
                                    BorderThickness="1" CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Height="88" Background="#E4E7EB" CornerRadius="3">
                                        <Image Source="{Binding PosterUrl}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,2,20,0">
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding MetaLabel}" Margin="0,5,0,0" Foreground="{DynamicResource ThemeMutedTextBrush}" />
                                        <TextBlock Text="{Binding CastLabel}" Margin="0,5,0,0"
                                                   Foreground="{DynamicResource ThemeTextBrush}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description}" Margin="0,7,0,0"
                                                   Foreground="{DynamicResource ThemeMutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Button Content="Voir" Command="{Binding DataContext.ShowHistoryItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" Style="{StaticResource SoftButton}" />
                                        <TextBlock Text="{Binding ViewedAtLabel}" Margin="0,7,0,0"
                                                   Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="10" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Fiche detaillee avant confirmation de l'ajout. -->
            <Grid Visibility="{Binding IsDetailPage, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button Content="Retour aux resultats" Command="{Binding BackToDiscoverCommand}"
                        HorizontalAlignment="Left" Height="34" Padding="12,0"
                        Style="{StaticResource SoftButton}" />
                <ScrollViewer Grid.Row="1" Margin="0,24,0,0" VerticalScrollBarVisibility="Auto"
                              Focusable="False" FocusVisualStyle="{x:Null}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="200" Height="300" VerticalAlignment="Top" HorizontalAlignment="Left"
                            Background="#E4E7EB" CornerRadius="6">
                        <Image Source="{Binding SelectedSearchResult.PosterUrl}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="26,0,0,0">
                        <TextBlock Text="{Binding SelectedSearchResult.Title}" FontSize="30"
                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="15">
                            <Run Text="{Binding SelectedSearchResult.TypeLabel, Mode=OneWay}" /><Run Text=" - " />
                            <Run Text="{Binding SelectedSearchResult.YearLabel, Mode=OneWay}" /><Run Text=" - Note TMDB " />
                            <Run Text="{Binding SelectedSearchResult.RatingLabel, Mode=OneWay}" />
                        </TextBlock>
                        <Button Content="Ajouter a ma liste" Command="{Binding AddSearchResultCommand}"
                                CommandParameter="{Binding SelectedSearchResult}"
                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,18,0,0" />
                        <TextBlock Text="Chargement des informations..." Margin="0,18,0,0" Foreground="{DynamicResource ThemeMutedTextBrush}"
                                   Visibility="{Binding IsLoadingDetails, Converter={StaticResource BoolToVisibility}}" />
                        <ContentControl Content="{Binding SelectedMediaDetails}"
                                        ContentTemplate="{StaticResource RichDetailsTemplate}" />
                        <TextBlock Text="{Binding SearchErrorMessage}" Margin="0,12,0,0" Foreground="{DynamicResource ThemeDangerBrush}"
                                   Visibility="{Binding HasSearchError, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding DetailsErrorMessage}" Margin="0,12,0,0" Foreground="{DynamicResource ThemeDangerBrush}"
                                   Visibility="{Binding HasDetailsError, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Fiche d'un media deja present dans la bibliotheque. -->
            <Grid Visibility="{Binding IsLibraryDetailPage, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button Content="Retour a la bibliotheque" Command="{Binding BackToLibraryCommand}"
                        HorizontalAlignment="Left" Style="{StaticResource SoftButton}" />
                <ScrollViewer Grid.Row="1" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto"
                              Focusable="False" FocusVisualStyle="{x:Null}">
                    <Grid>
                            <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="200" Height="300" VerticalAlignment="Top" HorizontalAlignment="Left"
                                Background="#E4E7EB" CornerRadius="6">
                            <Image Source="{Binding SelectedLibraryItem.PosterUrl}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="26,0,8,24" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedLibraryItem.Title}" FontSize="30"
                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="  Favori" Margin="14,9,0,0" Foreground="#B26A00" FontWeight="SemiBold"
                                           Visibility="{Binding SelectedLibraryItem.IsFavorite, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="14">
                                <Run Text="{Binding SelectedLibraryItem.TypeLabel, Mode=OneWay}" /><Run Text="  |  " />
                                <Run Text="{Binding SelectedLibraryItem.ReleaseDateLabel, Mode=OneWay}" /><Run Text="  |  TMDB " />
                                <Run Text="{Binding SelectedLibraryItem.CommunityRatingLabel, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding SelectedLibraryItem.StatusLabel}" Margin="0,18,0,0"
                                       Foreground="{DynamicResource ThemeAccentBrush}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedLibraryItem.ProgressLabel}" Margin="0,7,0,0"
                                       Foreground="{DynamicResource ThemeTextBrush}"
                                       Visibility="{Binding SelectedLibraryItem.SupportsEpisodeProgress, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="Chargement des informations..." Margin="0,18,0,0" Foreground="{DynamicResource ThemeMutedTextBrush}"
                                       Visibility="{Binding IsLoadingDetails, Converter={StaticResource BoolToVisibility}}" />
                            <ContentControl Content="{Binding SelectedMediaDetails}"
                                            ContentTemplate="{StaticResource RichDetailsTemplate}" />
                            <TextBlock Text="{Binding DetailsErrorMessage}" Margin="0,12,0,0" Foreground="{DynamicResource ThemeDangerBrush}"
                                       Visibility="{Binding HasDetailsError, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="Mes informations" Margin="0,26,0,0" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedLibraryItem.RatingLabel, StringFormat=Ma note : {0}}"
                                       Margin="0,8,0,0" Foreground="{DynamicResource ThemeTextBrush}" />
                            <TextBlock Text="{Binding SelectedLibraryItem.PersonalNotes}" Margin="0,8,0,0"
                                       Foreground="{DynamicResource ThemeAccentBrush}" TextWrapping="Wrap" FontStyle="Italic" />
                            <Button Content="Modifier mes informations"
                                    Command="{Binding EditMediaCommand}"
                                    CommandParameter="{Binding SelectedLibraryItem}"
                                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,26,0,0" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Banque : comptabilite personnelle du membre connecte. -->
            <Grid Visibility="{Binding IsBankPage, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Banque" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Suis tes recettes et tes depenses" Margin="0,5,0,0" Foreground="{DynamicResource ThemeMutedTextBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="Solde actuel" Foreground="{DynamicResource ThemeMutedTextBrush}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding CurrentBalanceLabel}" FontSize="28" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeTextBrush}" HorizontalAlignment="Right" />
                        <Button Content="Reinitialiser ce mois" Command="{Binding ResetBankMonthCommand}"
                                Height="28" Padding="10,0" Margin="0,7,0,0" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Margin="0,24,0,0" Padding="14" Background="{DynamicResource ThemeSurfaceBrush}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Solde de depart" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Column="1" Text="{Binding StartingBalanceText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="34" Padding="9,0" VerticalContentAlignment="Center" />
                        <Button Grid.Column="2" Content="Enregistrer" Command="{Binding SaveStartingBalanceCommand}"
                                Height="34" Padding="14,0" Margin="10,0,0,0" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Margin="0,12,0,0" Padding="14" Background="{DynamicResource ThemeSurfaceBrush}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="BankEntryLabelInput"
                                     Text="{Binding BankEntryLabel, UpdateSourceTrigger=PropertyChanged}"
                                     Height="36" Padding="10,0" VerticalContentAlignment="Center"
                                     ToolTip="Motif de l'operation" />
                            <TextBlock Text="Motif de l'operation" Margin="11,0,0,0"
                                       VerticalAlignment="Center" Foreground="#7B8490"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=BankEntryLabelInput}" Value="" />
                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=BankEntryLabelInput}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Grid Grid.Column="1" Margin="10,0,0,0">
                            <TextBox x:Name="BankEntryAmountInput"
                                     Text="{Binding BankEntryAmountText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="36" Padding="10,0" VerticalContentAlignment="Center"
                                     ToolTip="Montant de l'operation" />
                            <TextBlock Text="Montant" Margin="11,0,0,0"
                                       VerticalAlignment="Center" Foreground="#7B8490"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=BankEntryAmountInput}" Value="" />
                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=BankEntryAmountInput}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Grid.Column="2" Content="+ Recette" Command="{Binding AddIncomeCommand}"
                                Height="36" Padding="14,0" Margin="10,0,0,0"
                                Background="{DynamicResource ThemeAccentBrush}" Foreground="White"
                                BorderBrush="{DynamicResource ThemeAccentBrush}" />
                        <Button Grid.Column="3" Content="- Depense" Command="{Binding AddExpenseCommand}"
                                Height="36" Padding="14,0" Margin="8,0,0,0"
                                Background="#A43B36" Foreground="White" BorderBrush="#A43B36" />
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Expander Header="Historique par mois" Margin="0,0,0,12" IsExpanded="False">
                        <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding BankHistory}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource ThemeSurfaceBrush}"
                                                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding MonthLabel}" FontWeight="SemiBold" FontSize="15" />
                                                <TextBlock Text="{Binding SummaryLabel}" Margin="0,5,0,8" Foreground="{DynamicResource ThemeMutedTextBrush}" />
                                                <ItemsControl ItemsSource="{Binding Entries}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,3">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Label}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding AmountLabel}" FontWeight="SemiBold" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Expander>
                    <TextBlock Grid.Row="1" Text="Aucune operation pour le moment." Foreground="{DynamicResource ThemeMutedTextBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BankEntries.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ListView Grid.Row="1" ItemsSource="{Binding BankEntries}" Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,7" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,11" Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}"
                                        BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="{Binding DateLabel}" Margin="0,4,0,0" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="11" />
                                        </StackPanel>
                                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
                                            <TextBlock Text="{Binding AmountLabel}" Foreground="#287A55" FontSize="15" FontWeight="SemiBold"
                                                       Visibility="{Binding IsIncome, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding AmountLabel}" Foreground="#B33D36" FontSize="15" FontWeight="SemiBold"
                                                       Visibility="{Binding IsExpense, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                        <Button Grid.Column="2" Content="Supprimer"
                                                Command="{Binding DataContext.DeleteBankEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" Height="30" Padding="10,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="1" Text="{Binding BankErrorMessage}" Foreground="#A43B36"
                               VerticalAlignment="Bottom" Margin="0,0,0,4" />
                </Grid>
            </Grid>

            <!-- Parametres generaux de Nookly, independants des futurs modules. -->
            <Grid Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Parametres" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Personnalise le comportement de Nookly" Margin="0,5,0,0"
                               Foreground="{DynamicResource ThemeMutedTextBrush}" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" Margin="0,24,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Expander Header="Apparence" IsExpanded="True" Margin="0,0,0,24"
                                  Foreground="{DynamicResource ThemeTextBrush}" FontSize="18" FontWeight="SemiBold"
                                  Style="{StaticResource CleanExpander}">
                            <StackPanel Margin="19,8,0,0" TextElement.FontWeight="Normal">
                                <TextBlock Text="Palettes" Foreground="{DynamicResource ThemeMutedTextBrush}"
                                           FontSize="12" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <Button Content="Nookly" Tag="nookly" Click="ThemePreset_Click"
                                            Style="{StaticResource FilterTileButton}" />
                                    <Button Content="Nuit" Tag="night" Click="ThemePreset_Click"
                                            Style="{StaticResource FilterTileButton}" />
                                    <Button Content="Foret" Tag="forest" Click="ThemePreset_Click"
                                            Style="{StaticResource FilterTileButton}" />
                                    <Button Content="Bordeaux" Tag="burgundy" Click="ThemePreset_Click"
                                            Style="{StaticResource FilterTileButton}" />
                                    <Button Content="Ocean" Tag="ocean" Click="ThemePreset_Click"
                                            Style="{StaticResource FilterTileButton}" />
                                </WrapPanel>
                                <TextBlock Text="Personnalise" FontSize="14" FontWeight="SemiBold"
                                           Margin="0,13,0,8" />
                                <WrapPanel>
                                    <StackPanel Width="150" Margin="0,0,10,10">
                                        <TextBlock Text="Fond" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="11" />
                                        <TextBox x:Name="ThemeBackgroundInput" Height="32" Margin="0,4,0,0"
                                                 Padding="8,0" VerticalContentAlignment="Center" Style="{StaticResource RoundedTextBox}"
                                                 IsReadOnly="True" Focusable="False" Cursor="Hand" ToolTip="Choisir une couleur"
                                                 PreviewMouseLeftButtonDown="ThemeColorInput_Click" />
                                    </StackPanel>
                                    <StackPanel Width="150" Margin="0,0,10,10">
                                        <TextBlock Text="Cartes" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="11" />
                                        <TextBox x:Name="ThemeSurfaceInput" Height="32" Margin="0,4,0,0"
                                                 Padding="8,0" VerticalContentAlignment="Center" Style="{StaticResource RoundedTextBox}"
                                                 IsReadOnly="True" Focusable="False" Cursor="Hand" ToolTip="Choisir une couleur"
                                                 PreviewMouseLeftButtonDown="ThemeColorInput_Click" />
                                    </StackPanel>
                                    <StackPanel Width="150" Margin="0,0,10,10">
                                        <TextBlock Text="Menu lateral" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="11" />
                                        <TextBox x:Name="ThemeSidebarInput" Height="32" Margin="0,4,0,0"
                                                 Padding="8,0" VerticalContentAlignment="Center" Style="{StaticResource RoundedTextBox}"
                                                 IsReadOnly="True" Focusable="False" Cursor="Hand" ToolTip="Choisir une couleur"
                                                 PreviewMouseLeftButtonDown="ThemeColorInput_Click" />
                                    </StackPanel>
                                    <StackPanel Width="150" Margin="0,0,10,10">
                                        <TextBlock Text="Accent" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="11" />
                                        <TextBox x:Name="ThemeAccentInput" Height="32" Margin="0,4,0,0"
                                                 Padding="8,0" VerticalContentAlignment="Center" Style="{StaticResource RoundedTextBox}"
                                                 IsReadOnly="True" Focusable="False" Cursor="Hand" ToolTip="Choisir une couleur"
                                                 PreviewMouseLeftButtonDown="ThemeColorInput_Click" />
                                    </StackPanel>
                                    <StackPanel Width="150" Margin="0,0,10,10">
                                        <TextBlock Text="Texte" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="11" />
                                        <TextBox x:Name="ThemeTextInput" Height="32" Margin="0,4,0,0"
                                                 Padding="8,0" VerticalContentAlignment="Center" Style="{StaticResource RoundedTextBox}"
                                                 IsReadOnly="True" Focusable="False" Cursor="Hand" ToolTip="Choisir une couleur"
                                                 PreviewMouseLeftButtonDown="ThemeColorInput_Click" />
                                    </StackPanel>
                                    <StackPanel Width="150" Margin="0,0,10,10">
                                        <TextBlock Text="Texte secondaire" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="11" />
                                        <TextBox x:Name="ThemeMutedInput" Height="32" Margin="0,4,0,0"
                                                 Padding="8,0" VerticalContentAlignment="Center" Style="{StaticResource RoundedTextBox}"
                                                 IsReadOnly="True" Focusable="False" Cursor="Hand" ToolTip="Choisir une couleur"
                                                 PreviewMouseLeftButtonDown="ThemeColorInput_Click" />
                                    </StackPanel>
                                    <StackPanel Width="150" Margin="0,0,10,10">
                                        <TextBlock Text="Bordures" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="11" />
                                        <TextBox x:Name="ThemeBorderInput" Height="32" Margin="0,4,0,0"
                                                 Padding="8,0" VerticalContentAlignment="Center" Style="{StaticResource RoundedTextBox}"
                                                 IsReadOnly="True" Focusable="False" Cursor="Hand" ToolTip="Choisir une couleur"
                                                 PreviewMouseLeftButtonDown="ThemeColorInput_Click" />
                                    </StackPanel>
                                    <StackPanel Width="150" Margin="0,0,10,10">
                                        <TextBlock Text="Barre superieure" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="11" />
                                        <TextBox x:Name="ThemeTitleBarInput" Height="32" Margin="0,4,0,0"
                                                 Padding="8,0" VerticalContentAlignment="Center" Style="{StaticResource RoundedTextBox}"
                                                 IsReadOnly="True" Focusable="False" Cursor="Hand" ToolTip="Choisir une couleur"
                                                 PreviewMouseLeftButtonDown="ThemeColorInput_Click" />
                                    </StackPanel>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Appliquer" Click="ApplyCustomTheme_Click"
                                            Style="{StaticResource PrimaryButton}" />
                                    <Button Content="Retablir Nookly" Click="ResetTheme_Click"
                                            Style="{StaticResource SoftButton}" Margin="8,0,0,0" />
                                    <TextBlock x:Name="ThemeStatusText" Margin="12,0,0,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource ThemeMutedTextBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                        <TextBlock Text="Compte" FontSize="18" FontWeight="SemiBold" />
                        <CheckBox x:Name="StaySignedInCheckBox" Content="Rester connecte sur cet appareil"
                                  Margin="0,12,0,24" Height="28" Style="{StaticResource StaySignedInToggle}"
                                  Checked="StaySignedIn_Changed" Unchecked="StaySignedIn_Changed" />
                        <Expander Header="Suggestions masquees" IsExpanded="True"
                                  Foreground="#25302C" FontSize="18" FontWeight="SemiBold"
                                  Style="{StaticResource CleanExpander}">
                            <StackPanel TextElement.FontSize="12" TextElement.FontWeight="Normal">
                                <TextBlock Text="Gere les contenus retires de tes suggestions."
                                           Margin="19,3,0,12" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="12"
                                           FontWeight="Normal" />
                                <Grid Margin="0,0,0,10">
                            <TextBox x:Name="HiddenTitleSearchInput"
                                     Text="{Binding DislikedPreferencesSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Height="34" Padding="10,0" VerticalContentAlignment="Center"
                                     Style="{StaticResource RoundedTextBox}"
                                     ToolTip="Rechercher un titre masque"
                                     TextChanged="HiddenTitleSearchInput_Changed"
                                     GotKeyboardFocus="HiddenTitleSearchInput_Changed"
                                     LostKeyboardFocus="HiddenTitleSearchInput_Changed" />
                            <TextBlock x:Name="HiddenTitleSearchPlaceholder" Margin="11,0"
                                       VerticalAlignment="Center" Foreground="#9299A3"
                                       IsHitTestVisible="False" />
                                </Grid>
                                <Border Padding="0" Background="Transparent" BorderThickness="0">
                            <Grid>
                                <TextBlock Text="Aucun titre masque."
                                           Foreground="{DynamicResource ThemeMutedTextBrush}" VerticalAlignment="Center"
                                           Visibility="{Binding ShowNoDislikedPreferences, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="Aucun titre ne correspond a cette recherche."
                                           Foreground="{DynamicResource ThemeMutedTextBrush}" VerticalAlignment="Center"
                                           Visibility="{Binding ShowNoFilteredDislikedPreferences, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding FilteredDislikedPreferences}"
                                              Visibility="{Binding HasDislikedPreferences, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12,9" Margin="0,0,0,8"
                                                    Style="{StaticResource HoverCardBorder}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="76" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="64" Height="92" Background="#E4E7EB"
                                                            CornerRadius="3" VerticalAlignment="Center">
                                                        <Image Source="{Binding PosterUrl}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                   FontSize="14" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding MetaLabel}" Margin="0,4,0,0"
                                                                   Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="11" />
                                                        <TextBlock Text="{Binding CastLabel}" Margin="0,5,0,0"
                                                                   Foreground="{DynamicResource ThemeTextBrush}" FontSize="11"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Description}" Margin="0,6,0,0"
                                                                   Foreground="{DynamicResource ThemeTextBrush}" FontSize="12"
                                                                   TextWrapping="Wrap" MaxHeight="34"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="Restaurer"
                                                            Command="{Binding DataContext.RestoreDiscoveryPreferenceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" Style="{StaticResource RestoreButton}"
                                                            Margin="16,0,0,0" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Administration : aucune donnee personnelle des membres n'est exposee ici. -->
            <Grid x:Name="AdministrationPanel"
                  Visibility="{Binding DataContext.IsAdminPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Administration" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Comptes, activite et notifications. Les donnees personnelles restent privees."
                                   Margin="0,5,0,0" Foreground="{DynamicResource ThemeMutedTextBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Actualiser" Command="{Binding LoadCommand}"
                            Height="34" Padding="14,0" VerticalAlignment="Top" />
                </Grid>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Members}" SelectedItem="{Binding SelectedMember}"
                          Margin="0,22,0,0" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" CanUserAddRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pseudo" Binding="{Binding DisplayName}" Width="*" />
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*" />
                        <DataGridCheckBoxColumn Header="Confirme" Binding="{Binding IsEmailConfirmed, Mode=OneWay}" Width="90" />
                        <DataGridTextColumn Header="Temps utilise" Binding="{Binding UsageLabel}" Width="130" />
                        <DataGridTextColumn Header="Derniere activite" Binding="{Binding LastActivityLabel}" Width="160" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2" Margin="0,18,0,0" Padding="16" Background="{DynamicResource ThemeSurfaceBrush}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="Envoyer une notification" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Selectionne d'abord un utilisateur dans la liste."
                                   Margin="0,4,0,12" Foreground="{DynamicResource ThemeMutedTextBrush}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding NotificationTitle, UpdateSourceTrigger=PropertyChanged}"
                                     Height="36" Padding="9,0" VerticalContentAlignment="Center"
                                     ToolTip="Titre de la notification" />
                            <TextBox Grid.Column="1" Text="{Binding NotificationMessage, UpdateSourceTrigger=PropertyChanged}"
                                     Height="36" Margin="10,0" Padding="9,0" VerticalContentAlignment="Center"
                                     ToolTip="Message" />
                            <Button Grid.Column="2" Content="Envoyer" Command="{Binding SendNotificationCommand}"
                                    Height="36" Padding="15,0" Background="{DynamicResource ThemeAccentBrush}" Foreground="White" />
                        </Grid>
                        <TextBlock Text="{Binding StatusMessage}" Margin="0,10,0,0" Foreground="{DynamicResource ThemeAccentBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <Grid x:Name="CloseConfirmationOverlay" Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="100"
              Background="#7A11161C" Visibility="Collapsed">
            <Border Width="430" Padding="24" Background="{DynamicResource ThemeBackgroundBrush}"
                    BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Fermer Nookly" FontSize="20" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="&#xE711;" Click="CancelClose_Click"
                                Width="30" Height="30" Background="Transparent" BorderThickness="0"
                                FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource ThemeMutedTextBrush}"
                                Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="Annuler" />
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,18,0,22">
                        <TextBlock Text="Garder Nookly actif pres de l'horloge ?"
                                   FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Tu pourras le rouvrir depuis la zone de notification."
                                   Margin="0,7,0,0" Foreground="{DynamicResource ThemeMutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1" Content="Quitter completement" Click="ConfirmFullExit_Click"
                                Style="{StaticResource SoftButton}" Height="36" Margin="0,0,9,0" />
                        <Button Grid.Column="2" Content="Garder en arriere-plan" Click="ConfirmTray_Click"
                                Style="{StaticResource PrimaryButton}" Height="36" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
