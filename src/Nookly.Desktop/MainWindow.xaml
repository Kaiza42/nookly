<Window x:Class="Nookly.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nookly"
        Height="600"
        Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F4F5F7">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Text="Bienvenue dans Nookly"
                       FontSize="32"
                       FontWeight="SemiBold"
                       Foreground="#202124"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Ton espace personnel"
                       FontSize="16"
                       Foreground="#6B7280"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center" />
            <Button Content="Commencer"
                    Width="150"
                    Height="42"
                    Margin="0,24,0,0"
                    FontSize="15"
                    Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>
