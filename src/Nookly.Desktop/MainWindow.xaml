<Window x:Class="Nookly.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Nookly.Desktop.Converters"
        Title="Nookly"
        Height="680"
        Width="1080"
        MinHeight="560"
        MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded"
        Background="#F5F6F8">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="12,2" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#B8C0CC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#20242B">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="78" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="60" />
                </Grid.RowDefinitions>

                <TextBlock Text="Nookly"
                           Margin="26,0"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="SemiBold" />

                <StackPanel Grid.Row="1">
                    <Button Content="Accueil" Style="{StaticResource NavButtonStyle}" />
                    <Button Content="Bibliotheque"
                            Style="{StaticResource NavButtonStyle}"
                            Background="#343A44"
                            Foreground="White"
                            FontWeight="SemiBold" />
                    <Button Content="Notes" Style="{StaticResource NavButtonStyle}" />
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Text="Espace personnel"
                           Margin="26,0"
                           VerticalAlignment="Center"
                           Foreground="#7F8997"
                           FontSize="12" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="34,28,34,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Bibliotheque"
                               Foreground="#20242B"
                               FontSize="28"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Tes films, series, animes et mangas"
                               Margin="0,5,0,0"
                               Foreground="#69717D"
                               FontSize="14" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="+ Ajouter"
                            Command="{Binding ToggleCreatePanelCommand}"
                            MinWidth="100"
                            Height="38"
                            Padding="16,0"
                            Margin="0,0,8,0"
                            Background="#286C53"
                            Foreground="White"
                            BorderBrush="#286C53"
                            Cursor="Hand" />
                    <Button Content="Actualiser"
                            Command="{Binding LoadCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                            MinWidth="110"
                            Height="38"
                            Padding="16,0"
                            Background="#FFFFFF"
                            Foreground="#20242B"
                            BorderBrush="#D7DBE1"
                            Cursor="Hand" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,22,0,0"
                    Padding="14"
                    Background="White"
                    BorderBrush="#D7DBE1"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Height="38"
                                 Padding="11,8"
                                 BorderBrush="#C9CED6"
                                 ToolTip="Rechercher un film ou une serie sur TMDB" />
                        <Button Grid.Column="1"
                                Content="Rechercher"
                                Command="{Binding SearchCommand}"
                                Height="38"
                                MinWidth="105"
                                Margin="10,0,0,0"
                                Padding="15,0"
                                Background="#286C53"
                                Foreground="White"
                                BorderBrush="#286C53"
                                Cursor="Hand" />
                    </Grid>

                    <ProgressBar Height="3"
                                 Margin="0,10,0,0"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <TextBlock Text="{Binding SearchErrorMessage}"
                               Margin="0,10,0,0"
                               Foreground="#8E2F2A"
                               Visibility="{Binding HasSearchError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <ListBox ItemsSource="{Binding SearchResults}"
                             Margin="0,12,0,0"
                             Height="190"
                             Visibility="{Binding HasSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,10,0" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="360"
                                        Height="168"
                                        Padding="10"
                                        Background="#F8F9FA"
                                        BorderBrush="#E0E3E8"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#E4E7EB" CornerRadius="3">
                                            <Image Source="{Binding PosterUrl}"
                                                   Stretch="UniformToFill" />
                                        </Border>
                                        <Grid Grid.Column="1" Margin="12,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="#20242B"
                                                       FontWeight="SemiBold"
                                                       FontSize="15"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="1"
                                                       Margin="0,4,0,0"
                                                       Foreground="#69717D">
                                                <Run Text="{Binding TypeLabel}" />
                                                <Run Text=" - " />
                                                <Run Text="{Binding YearLabel}" />
                                                <Run Text=" - " />
                                                <Run Text="{Binding RatingLabel}" />
                                            </TextBlock>
                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding Description}"
                                                       Margin="0,7,0,4"
                                                       Foreground="#747D89"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="52"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Row="3"
                                                    Content="Ajouter a ma liste"
                                                    Command="{Binding DataContext.AddSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Height="30"
                                                    Padding="10,0"
                                                    HorizontalAlignment="Left"
                                                    Background="#286C53"
                                                    Foreground="White"
                                                    BorderBrush="#286C53"
                                                    Cursor="Hand" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Margin="0,22,0,0"
                    Padding="18"
                    Background="White"
                    BorderBrush="#D7DBE1"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding IsCreatePanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.ColumnSpan="4"
                               Text="{Binding FormTitle}"
                               Margin="0,0,0,14"
                               Foreground="#20242B"
                               FontSize="16"
                               FontWeight="SemiBold" />

                    <StackPanel Grid.Row="1" Margin="0,0,12,0">
                        <TextBlock Text="Titre"
                                   Margin="0,0,0,6"
                                   Foreground="#4D5967"
                                   FontSize="12" />
                        <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36"
                                 Padding="10,7"
                                 BorderBrush="#C9CED6" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Type"
                                   Margin="0,0,0,6"
                                   Foreground="#4D5967"
                                   FontSize="12" />
                        <ComboBox ItemsSource="{Binding MediaTypes}"
                                  SelectedItem="{Binding SelectedMediaType}"
                                  DisplayMemberPath="Label"
                                  Height="36"
                                  Padding="8,5"
                                  BorderBrush="#C9CED6" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="Description"
                                   Margin="0,0,0,6"
                                   Foreground="#4D5967"
                                   FontSize="12" />
                        <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36"
                                 Padding="10,7"
                                 BorderBrush="#C9CED6" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Grid.Column="3"
                                Margin="0,18,0,0"
                                Orientation="Horizontal">
                        <Button Content="Annuler"
                                Command="{Binding ToggleCreatePanelCommand}"
                                Height="36"
                                Padding="13,0"
                                Margin="0,0,8,0"
                                Background="White"
                                BorderBrush="#C9CED6"
                                Cursor="Hand" />
                        <Button Content="{Binding SaveButtonLabel}"
                                Command="{Binding SaveMediaCommand}"
                                Height="36"
                                Padding="15,0"
                                Background="#286C53"
                                Foreground="White"
                                BorderBrush="#286C53"
                                Cursor="Hand" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,12,12,0">
                        <TextBlock Text="Statut"
                                   Margin="0,0,0,6"
                                   Foreground="#4D5967"
                                   FontSize="12" />
                        <ComboBox ItemsSource="{Binding MediaStatuses}"
                                  SelectedItem="{Binding SelectedMediaStatus}"
                                  DisplayMemberPath="Label"
                                  Height="36"
                                  Padding="8,5"
                                  BorderBrush="#C9CED6" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,12,12,0">
                        <TextBlock Text="Note personnelle"
                                   Margin="0,0,0,6"
                                   Foreground="#4D5967"
                                   FontSize="12" />
                        <ComboBox ItemsSource="{Binding Ratings}"
                                  SelectedItem="{Binding SelectedRating}"
                                  DisplayMemberPath="Label"
                                  Height="36"
                                  Padding="8,5"
                                  BorderBrush="#C9CED6" />
                    </StackPanel>

                    <TextBlock Grid.Row="3"
                               Grid.ColumnSpan="4"
                               Text="{Binding FormErrorMessage}"
                               Margin="0,12,0,0"
                               Foreground="#8E2F2A"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasFormError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Margin="0,14,0,0"
                    Padding="14,11"
                    Background="#FFF1F0"
                    BorderBrush="#E6A39E"
                    BorderThickness="1"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#8E2F2A"
                           TextWrapping="Wrap" />
            </Border>

            <Grid Grid.Row="4" Margin="0,22,0,0">
                <ProgressBar Height="3"
                             VerticalAlignment="Top"
                             IsIndeterminate="True"
                             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Ta bibliotheque est vide"
                               HorizontalAlignment="Center"
                               Foreground="#343A44"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Les medias ajoutes apparaitront ici."
                               Margin="0,7,0,0"
                               Foreground="#7A838F"
                               FontSize="14" />
                </StackPanel>

                <ListView ItemsSource="{Binding Items}"
                          Visibility="{Binding HasItems, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Background="Transparent"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="18,14"
                                    Background="White"
                                    BorderBrush="#E0E3E8"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="#20242B"
                                                   FontSize="16"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}"
                                                   Margin="0,4,18,0"
                                                   Foreground="#747D89"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TypeLabel}"
                                               VerticalAlignment="Center"
                                               Foreground="#4D5967" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding StatusLabel}"
                                               VerticalAlignment="Center"
                                               Foreground="#286C53"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding RatingLabel}"
                                               VerticalAlignment="Center"
                                               Foreground="#4D5967"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding AddedDateLabel}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Foreground="#7A838F" />
                                    <StackPanel Grid.Column="5"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <Button Content="Modifier"
                                                Command="{Binding DataContext.EditMediaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Height="30"
                                                Padding="10,0"
                                                Margin="0,0,6,0"
                                                Background="White"
                                                BorderBrush="#C9CED6"
                                                Cursor="Hand" />
                                        <Button Content="Supprimer"
                                                Command="{Binding DataContext.DeleteMediaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Height="30"
                                                Padding="10,0"
                                                Background="#FFF1F0"
                                                Foreground="#8E2F2A"
                                                BorderBrush="#E6A39E"
                                                Cursor="Hand" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Window>
