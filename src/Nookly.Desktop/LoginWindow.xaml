<Window x:Class="Nookly.Desktop.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Nookly" Height="620" Width="400"
        MinHeight="520" MinWidth="360" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="#F5F6F8">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,32,36,28">
            <TextBlock Text="Nookly" FontSize="30" FontWeight="SemiBold" />
            <TextBlock x:Name="Subtitle" Text="Connecte-toi a ton espace personnel" Margin="0,7,0,28" Foreground="#69717D" />
            <TextBlock x:Name="PseudoLabel" Text="Pseudo" Margin="0,0,0,6" Visibility="Collapsed" />
            <TextBox x:Name="PseudoBox" Height="38" Padding="10,0" VerticalContentAlignment="Center" Visibility="Collapsed" Margin="0,0,0,14" />
            <TextBlock Text="Email" Margin="0,0,0,6" />
            <TextBox x:Name="EmailBox" Height="38" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,14" />
            <TextBlock Text="Mot de passe" Margin="0,0,0,6" />
            <PasswordBox x:Name="PasswordBox" Height="38" Padding="10,0" VerticalContentAlignment="Center" />
            <CheckBox x:Name="StaySignedInBox" Content="Rester connecte" Margin="0,16,0,0" />
            <Button Content="Mot de passe oublie ?" Click="ForgotPassword_Click" Height="28" Margin="0,6,0,0"
                    HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="#286C53" />
            <TextBlock x:Name="ErrorText" Foreground="#A43B36" Margin="0,12,0,0" TextWrapping="Wrap" />
            <Button x:Name="SubmitButton" Content="Se connecter" Click="Submit_Click" IsDefault="True"
                    Height="40" Margin="0,18,0,0"
                    Background="#286C53" Foreground="White" BorderBrush="#286C53" />
            <Button x:Name="SwitchButton" Content="Creer un compte" Click="Switch_Click" Height="34" Margin="0,10,0,0"
                    Background="Transparent" BorderThickness="0" Foreground="#286C53" />
        </StackPanel>
    </ScrollViewer>
</Window>
