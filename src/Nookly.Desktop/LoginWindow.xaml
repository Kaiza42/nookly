<Window x:Class="Nookly.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Nookly" Height="610" Width="440" MinHeight="570" MinWidth="400"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        StateChanged="Window_StateChanged" Background="{DynamicResource ThemeBackgroundBrush}"
        Foreground="{DynamicResource ThemeTextBrush}" BorderThickness="0" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="9" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#12000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AuthTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AuthPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StayToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Track" Width="34" Height="19" HorizontalAlignment="Left"
                                    Background="#D4DADF" BorderBrush="{DynamicResource ThemeBorderBrush}"
                                    BorderThickness="1" CornerRadius="10">
                                <Ellipse x:Name="Thumb" Width="13" Height="13" Margin="2"
                                         HorizontalAlignment="Left" Fill="White" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.86" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryAuthButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThemeAccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Background="{DynamicResource ThemeBackgroundBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="&#xE921;" Click="MinimizeWindow_Click" Style="{StaticResource TitleButton}" ToolTip="Reduire" />
                <Button x:Name="MaxRestoreButton" Content="&#xE922;" Click="MaxRestoreWindow_Click"
                        Style="{StaticResource TitleButton}" ToolTip="Agrandir" />
                <Button Content="&#xE8BB;" Click="CloseWindow_Click" Style="{StaticResource TitleButton}" ToolTip="Fermer" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="48,34,48,38">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" Background="{DynamicResource ThemeAccentBrush}" CornerRadius="6">
                            <TextBlock Text="N" Foreground="White" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Nookly" Margin="11,0,0,0" FontSize="28" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="Subtitle" Text="Connecte-toi a ton espace personnel"
                               Margin="0,12,0,30" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="13" />
                    <TextBlock x:Name="PseudoLabel" Text="Pseudo" Margin="0,0,0,7" FontWeight="SemiBold"
                               Visibility="Collapsed" />
                    <TextBox x:Name="PseudoBox" Style="{StaticResource AuthTextBox}"
                             Visibility="Collapsed" Margin="0,0,0,16" />
                    <TextBlock Text="Adresse email" Margin="0,0,0,7" FontWeight="SemiBold" />
                    <TextBox x:Name="EmailBox" Style="{StaticResource AuthTextBox}" Margin="0,0,0,16" />
                    <TextBlock Text="Mot de passe" Margin="0,0,0,7" FontWeight="SemiBold" />
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource AuthPasswordBox}" />
                    <Grid Margin="0,15,0,0">
                        <CheckBox x:Name="StaySignedInBox" Content="Rester connecte" Height="24"
                                  Style="{StaticResource StayToggle}" HorizontalAlignment="Left" />
                        <Button x:Name="ForgotPasswordButton" Content="Mot de passe oublie ?"
                                Click="ForgotPassword_Click" Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Right" />
                    </Grid>
                    <Border x:Name="ErrorSurface" Margin="0,16,0,0" Padding="11,8"
                            Background="#FFF1F0" BorderBrush="#E8C4C1" BorderThickness="1"
                            CornerRadius="5" Visibility="Collapsed">
                        <TextBlock x:Name="ErrorText" Foreground="#9B3833" TextWrapping="Wrap" />
                    </Border>
                    <Button x:Name="SubmitButton" Content="Se connecter" Click="Submit_Click" IsDefault="True"
                            Margin="0,24,0,0" Style="{StaticResource PrimaryAuthButton}" />
                </StackPanel>
                <Border Grid.Row="1" Height="1" Margin="0,28,0,22" Background="{DynamicResource ThemeBorderBrush}" />
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="SwitchPrompt" Text="Pas encore de compte ?" VerticalAlignment="Center"
                               Foreground="{DynamicResource ThemeMutedTextBrush}" />
                    <Button x:Name="SwitchButton" Content="Creer un compte" Click="Switch_Click"
                            Margin="7,0,0,0" Style="{StaticResource LinkButton}" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
