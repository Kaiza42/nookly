<Window x:Class="Nookly.Desktop.PasswordResetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mot de passe oublie" Height="470" Width="460"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F5F6F8">
    <Grid Margin="38"><StackPanel VerticalAlignment="Center">
        <TextBlock Text="Retrouver mon compte" FontSize="25" FontWeight="SemiBold" />
        <TextBlock Text="Demande un code par email, puis choisis un nouveau mot de passe." Margin="0,7,0,24" Foreground="#69717D" TextWrapping="Wrap" />
        <TextBlock Text="Email" Margin="0,0,0,5"/><TextBox x:Name="EmailBox" Height="36" Padding="9,0" VerticalContentAlignment="Center"/>
        <Button Content="Envoyer le code" Click="SendCode_Click" Height="36" Margin="0,10,0,20"/>
        <TextBlock Text="Code recu" Margin="0,0,0,5"/><TextBox x:Name="TokenBox" Height="36" Padding="9,0" VerticalContentAlignment="Center"/>
        <TextBlock Text="Nouveau mot de passe" Margin="0,12,0,5"/><PasswordBox x:Name="NewPasswordBox" Height="36" Padding="9,0" VerticalContentAlignment="Center"/>
        <TextBlock x:Name="StatusText" Margin="0,10,0,0" Foreground="#286C53" TextWrapping="Wrap"/>
        <Button Content="Modifier le mot de passe" Click="Reset_Click" Height="38" Margin="0,14,0,0" Background="#286C53" Foreground="White"/>
    </StackPanel></Grid>
</Window>
