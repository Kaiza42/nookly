<Window x:Class="Nookly.Desktop.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nookly" Width="520" Height="300" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <Border Background="{DynamicResource ThemeSidebarBrush}" CornerRadius="9"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
        <Grid Margin="46">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Nookly" Foreground="{DynamicResource ThemeAccentBrush}" FontSize="18"
                           FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="WelcomeText" Margin="0,24,0,0" Foreground="White"
                           FontSize="32" FontWeight="SemiBold" TextAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="SubtitleText" Text="Ton espace personnel est pret."
                           Margin="0,10,0,0" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="14"
                           HorizontalAlignment="Center" />
                <ProgressBar Margin="0,32,0,0" Width="240" Height="3"
                             IsIndeterminate="True" Foreground="{DynamicResource ThemeAccentBrush}"
                             Background="{DynamicResource ThemeSidebarHoverBrush}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
