<Window x:Class="Nookly.Desktop.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nookly" Width="520" Height="300" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <Border Background="#20242B" CornerRadius="6" BorderBrush="#343A43" BorderThickness="1">
        <Grid Margin="46">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Nookly" Foreground="#8EC9B0" FontSize="18"
                           FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="WelcomeText" Margin="0,24,0,0" Foreground="White"
                           FontSize="32" FontWeight="SemiBold" TextAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock Text="Ton espace personnel est pret."
                           Margin="0,10,0,0" Foreground="#B8C0CC" FontSize="14"
                           HorizontalAlignment="Center" />
                <ProgressBar Margin="0,32,0,0" Width="240" Height="3"
                             IsIndeterminate="True" Foreground="#5BA789" Background="#343A43" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
