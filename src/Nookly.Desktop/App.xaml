<Application x:Class="Nookly.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="#F5F6F8" />
        <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ThemeSidebarBrush" Color="#20242B" />
        <SolidColorBrush x:Key="ThemeAccentBrush" Color="#286C53" />
        <SolidColorBrush x:Key="ThemeAccentHoverBrush" Color="#205743" />
        <SolidColorBrush x:Key="ThemeSidebarHoverBrush" Color="#292F37" />
        <SolidColorBrush x:Key="ThemeTextBrush" Color="#11161C" />
        <SolidColorBrush x:Key="ThemeMutedTextBrush" Color="#69717D" />
        <SolidColorBrush x:Key="ThemeBorderBrush" Color="#D7DBE1" />
        <SolidColorBrush x:Key="ThemeTitleBarBrush" Color="#DDE1E5" />
    </Application.Resources>
</Application>
