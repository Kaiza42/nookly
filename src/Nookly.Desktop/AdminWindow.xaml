<Window x:Class="Nookly.Desktop.AdminWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Nookly Administration" Height="720" Width="1100"
        MinHeight="560" MinWidth="820" WindowStartupLocation="CenterScreen" Background="#F5F6F8">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#20242B"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="Nookly" FontSize="25" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="Administration" Margin="0,5,0,0" Foreground="#B8C0CC"/></StackPanel>
            <Button Grid.Row="1" Content="Se deconnecter" Click="Logout_Click" Height="38" Background="Transparent" Foreground="White" BorderBrush="#59616D"/>
        </Grid></Border>
        <Grid Grid.Column="1" Margin="32,26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="Utilisateurs" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Emails, validation du compte et temps d'utilisation. Les donnees personnelles restent privees." Margin="0,5,0,20" Foreground="#69717D"/></StackPanel>
            <DataGrid x:Name="MembersGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Pseudo" Binding="{Binding DisplayName}" Width="*"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*"/>
                    <DataGridCheckBoxColumn Header="Confirme" Binding="{Binding IsEmailConfirmed}" Width="90"/>
                    <DataGridTextColumn Header="Temps utilise" Binding="{Binding UsageLabel}" Width="130"/>
                    <DataGridTextColumn Header="Derniere activite" Binding="{Binding LastActivityLabel}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="2" Margin="0,18,0,0" Padding="16" Background="White" BorderBrush="#D7DBE1" BorderThickness="1" CornerRadius="6">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="NotificationTitleBox" Height="36" Padding="9,0" VerticalContentAlignment="Center" ToolTip="Titre de la notification"/>
                    <TextBox x:Name="NotificationMessageBox" Grid.Column="1" Height="36" Margin="10,0" Padding="9,0" VerticalContentAlignment="Center" ToolTip="Message"/>
                    <Button Grid.Column="2" Content="Envoyer la notification" Click="SendNotification_Click" Height="36" Padding="15,0" Background="#286C53" Foreground="White"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
